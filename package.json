{
  "name": "ytdown",
  "private": true,
  "version": "0.6.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release:patch": "changelogen --release --patch",
    "release:minor": "changelogen --release --minor",
    "release:major": "changelogen --release --major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "croner": "^10.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-i18n": "^10.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "changelog": {
    "types": {
      "feat": {
        "title": "🚀 新機能",
        "semver": "minor"
      },
      "fix": {
        "title": "🐛 バグ修正",
        "semver": "patch"
      },
      "perf": {
        "title": "⚡ パフォーマンスの向上",
        "semver": "patch"
      },
      "refactor": {
        "title": "♻️ リファクタリング",
        "semver": "patch"
      },
      "docs": {
        "title": "📖 ドキュメント"
      },
      "style": {
        "title": "🎨 コードスタイル"
      },
      "test": {
        "title": "✅ テストの追加・修正"
      },
      "ci": {
        "title": "🤖 CI関連"
      },
      "build": {
        "title": "📦 ビルド",
        "semver": "patch"
      },
      "chore": {
        "title": "🧹 ビルドプロセスまたは補助ツールの変更"
      },
      "config": {
        "title": "🔧 設定ファイル"
      },
      "package": {
        "title": "📦 パッケージ"
      }
    },
    "templates": {
      "commitMessage": "chore(release): 🏹v{{newVersion}}",
      "tagMessage": "v{{newVersion}}",
      "tagBody": "v{{newVersion}}"
    }
  }
}
